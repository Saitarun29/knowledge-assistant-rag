# Copy to .env for local runs, or set the same names in the Vercel project.
# Names and purposes only — never put real values in this file.

# Optional. Enables live Gemini answers in /api/ask; without it the app runs in demo mode.
GEMINI_API_KEY=

# n8n ingest only: Google Drive folder that holds the knowledge-base Google Docs.
KB_DRIVE_FOLDER_ID=

# n8n ingest only: Notion integration token for the knowledge-base source.
NOTION_TOKEN=

# n8n ingest only: Notion database that holds the knowledge-base pages.
NOTION_KB_DATABASE_ID=

# n8n ingest only: creates embeddings (text-embedding-3-small) for Supabase pgvector.
OPENAI_API_KEY=

# n8n ingest only: Supabase project URL the ingest workflow writes to.
SUPABASE_URL=

# n8n ingest only: service-role key for those writes. Server-side only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# n8n runtime only: lets the ingest workflow's function nodes use Node's crypto module for hashing.
NODE_FUNCTION_ALLOW_BUILTIN=
