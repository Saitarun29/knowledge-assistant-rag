    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Shape every source into one document contract.\nconst files = $('Split Drive files').all();\nreturn $input.all().map((item, i) => {\n  const f = files[i].json;\n  return { json: {\n    source: 'gdrive',\n    docId: `gdrive:${f.id}`,\n    title: f.name,\n    url: f.webViewLink,\n    owner: f.lastModifyingUser?.displayName || null,\n    updatedAt: f.modifiedTime,\n    text: String(item.json.text || '').replace(/\\r/g, ''),\n  } };\n});"
      },
