      "id": "66343bf5-c8a0-4eb2-a104-3ef13f23f2e6",
      "name": "Upsert to Supabase (pgvector)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Chunks that no longer exist in an edited doc must be removed from the index.\nconst byDoc = {};\nfor (const { json: c } of $('Attach vectors').all()) (byDoc[c.doc_id] ||= []).push(c.chunk_id);\nreturn Object.entries(byDoc).map(([doc_id, keep_ids]) => ({ json: { doc_id, keep_ids } }));"
      },
