      "id": "5a9673fb-0270-4420-ae0e-1dc9874dea16",
      "name": "Notion: get page blocks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        340
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Flatten Notion blocks to markdown-ish text (headings become chunk boundaries).\nconst pages = $('Split Notion pages').all();\nconst rt = (arr = []) => arr.map((t) => t.plain_text).join('');\nconst toLine = (b) => {\n  const v = b[b.type] || {};\n  switch (b.type) {\n    case 'heading_1': return `# ${rt(v.rich_text)}`;\n    case 'heading_2': return `## ${rt(v.rich_text)}`;\n    case 'heading_3': return `### ${rt(v.rich_text)}`;\n    case 'bulleted_list_item': case 'to_do': return `- ${rt(v.rich_text)}`;\n    case 'numbered_list_item': return `1. ${rt(v.rich_text)}`;\n    case 'quote': case 'callout': case 'paragraph': return rt(v.rich_text);\n    case 'code': return rt(v.rich_text);\n    default: return '';\n  }\n};\nreturn $input.all().map((item, i) => {\n  const p = pages[i].json;\n  const titleProp = Object.values(p.properties || {}).find((x) => x.type === 'title');\n  return { json: {\n    source: 'notion',\n    docId: `notion:${p.id}`,\n    title: rt(titleProp?.title) || 'Untitled',\n    url: p.url,\n    owner: p.last_edited_by?.id || null,\n    updatedAt: p.last_edited_time,\n    text: (item.json.results || []).map(toLine).filter(Boolean).join('\\n\\n'),\n  } };\n});"
      },
      "id": "9467e582-b935-4d36-bd57-29543b5effe9",
      "name": "Normalise Notion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        340
      ]
    },
    {
      "parameters": {},
      "id": "34a52819-1ba8-44d6-862d-137bb03195b5",
      "name": "Merge sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1520,
        220
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Heading-aware chunking with overlap — same strategy as lib/rag.js in the app.\nconst crypto = require('crypto');\nconst MAX = 900, OVERLAP = 150;\nconst out = [];\nfor (const { json: doc } of $input.all()) {\n  if (!doc.text || doc.text.trim().length < 40) continue;\n  const sections = [];\n  let cur = { heading: doc.title, body: [] };\n  for (const line of doc.text.split('\\n')) {\n    const h = line.match(/^#{1,3}\\s+(.+)/);\n    if (h) { if (cur.body.join('').trim()) sections.push(cur); cur = { heading: h[1].trim(), body: [] }; }\n    else cur.body.push(line);\n  }\n  if (cur.body.join('').trim()) sections.push(cur);\n  let n = 0;\n  for (const s of sections) {\n    const text = s.body.join('\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\n    for (let start = 0; start < text.length; start += MAX - OVERLAP) {\n      let end = Math.min(start + MAX, text.length);\n      if (end < text.length) { const cut = text.lastIndexOf('\\n', end); if (cut > start + MAX / 2) end = cut; }\n      const content = text.slice(start, end).trim();\n      if (!content) continue;\n      const embedText = `${doc.title} › ${s.heading}\\n${content}`;\n      out.push({ json: {\n        chunk_id: `${doc.docId}#${++n}`,\n        doc_id: doc.docId, source: doc.source, title: doc.title, url: doc.url, section: s.heading,\n        content, embed_text: embedText,\n        content_hash: crypto.createHash('sha256').update(embedText).digest('hex'),\n        token_estimate: Math.ceil(embedText.length / 4), updated_at: doc.updatedAt,\n      } });\n      if (end >= text.length) break;\n    }\n  }\n}\nreturn out;"
      },
