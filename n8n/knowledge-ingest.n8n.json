        "jsonBody": "={{ JSON.stringify({ p_doc_id: $json.doc_id, p_keep_ids: $json.keep_ids }) }}",
        "options": {}
      },
      "id": "67bd0054-005a-4153-aed7-33ca534717c7",
      "name": "Prune stale chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2840,
        220
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const state = $getWorkflowStaticData('global');\nstate.lastSuccessfulRun = $('Get watermark').first().json.startedAt;\nconst chunks = $('Attach vectors').all().length;\nconst docs = $('Group chunk ids per doc').all().length;\nreturn [{ json: { ok: true, docs, chunks, watermark: state.lastSuccessfulRun } }];"
      },
      "id": "35283f16-96ca-4dfc-9b4e-e70727f3af1d",
